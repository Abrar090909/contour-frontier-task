diff --git a/packages/cli/src/canvas/push.ts b/packages/cli/src/canvas/push.ts
new file mode 100644
index 0000000..840a7e8
--- /dev/null
+++ b/packages/cli/src/canvas/push.ts
@@ -0,0 +1,229 @@
+import { isDeepStrictEqual } from "node:util";
+import type { GraphDoc } from "@contour/schema";
+
+import {
+  canvasRevisionConflict,
+  fetchCanvas,
+  pushCanvas,
+  type Fetched,
+} from "./api.js";
+import {
+  REGISTRY_PATH,
+  updateRegistry,
+  type CanvasEntry,
+  type Registered,
+} from "./registry.js";
+import { requireSameApi, requireWriteToken } from "./write.js";
+import type { Terminal } from "../terminal.js";
+import { PrLensCliError } from "../errors.js";
+
+type PendingPush = NonNullable<CanvasEntry["pendingPush"]>;
+export type PublishedCanvas = Pick<
+  Fetched,
+  "id" | "rev" | "viewUrl" | "embedUrl" | "tiles"
+>;
+
+export const sameGraphDocument = (a: GraphDoc, b: GraphDoc): boolean =>
+  isDeepStrictEqual(a, b);
+
+const samePendingPush = (a: PendingPush | undefined, b: PendingPush): boolean =>
+  a !== undefined &&
+  a.baseRev === b.baseRev &&
+  a.source === b.source &&
+  sameGraphDocument(a.document, b.document);
+
+const registryChanged = (id: string): PrLensCliError =>
+  new PrLensCliError(
+    "UNREADABLE_FILE",
+    `${REGISTRY_PATH} changed while the push for ${id} was being settled`,
+    "run contour canvas push again",
+  );
+
+const acknowledge = async (
+  api: string,
+  id: string,
+  pending: PendingPush,
+  rev: number,
+  terminal: Terminal,
+): Promise<Registered> => {
+  let registered: Registered | undefined;
+  await updateRegistry((registry) => {
+    const current = registry.canvases[id];
+    if (
+      current === undefined ||
+      current.api !== api ||
+      !samePendingPush(current.pendingPush, pending)
+    )
+      return;
+
+    const entry: CanvasEntry = {
+      ...current,
+      source: pending.source,
+      rev,
+      pendingPush: undefined,
+    };
+    registry.canvases[id] = entry;
+    registered = { id, entry };
+  }, terminal);
+
+  if (registered === undefined) throw registryChanged(id);
+  return registered;
+};
+
+const clearDefiniteFailure = async (
+  api: string,
+  id: string,
+  pending: PendingPush,
+  terminal: Terminal,
+): Promise<void> => {
+  await updateRegistry((registry) => {
+    const current = registry.canvases[id];
+    if (
+      current === undefined ||
+      current.api !== api ||
+      !samePendingPush(current.pendingPush, pending)
+    )
+      return;
+    registry.canvases[id] = { ...current, pendingPush: undefined };
+  }, terminal);
+};
+
+const isDefiniteRefusal = (error: PrLensCliError): boolean =>
+  error.code === "CANVAS_CONFLICT" ||
+  error.code === "CANVAS_REJECTED" ||
+  error.code === "CANVAS_UNKNOWN" ||
+  error.code === "CANVAS_RATE_LIMITED";
+
+const carryOut = async (
+  api: string,
+  registered: Registered,
+  pending: PendingPush,
+  terminal: Terminal,
+  clearRefusal: boolean,
+): Promise<{ registered: Registered; published: PublishedCanvas }> => {
+  const published = await pushCanvas(
+    api,
+    registered.id,
+    requireWriteToken(registered),
+    pending.baseRev,
+    pending.document,
+  ).catch(async (error: unknown) => {
+    if (
+      clearRefusal &&
+      error instanceof PrLensCliError &&
+      isDefiniteRefusal(error)
+    )
+      await clearDefiniteFailure(api, registered.id, pending, terminal);
+    throw error;
+  });
+
+  return {
+    registered: await acknowledge(
+      api,
+      registered.id,
+      pending,
+      published.rev,
+      terminal,
+    ),
+    published,
+  };
+};
+
+export type SettledPendingPush = {
+  registered: Registered;
+  attempted: GraphDoc | undefined;
+  published: PublishedCanvas | undefined;
+};
+
+/** Reconciles an earlier uncertain push before the caller considers today's document. */
+export const settlePendingPush = async (
+  api: string,
+  registered: Registered,
+  terminal: Terminal,
+): Promise<SettledPendingPush> => {
+  requireSameApi(api, registered);
+  requireWriteToken(registered);
+  const pending = registered.entry.pendingPush;
+  if (pending === undefined)
+    return { registered, attempted: undefined, published: undefined };
+
+  const fetched = await fetchCanvas(api, registered.id).catch(
+    (error: unknown) => {
+      if (
+        pending.baseRev === 0 &&
+        error instanceof PrLensCliError &&
+        error.code === "CANVAS_UNKNOWN"
+      )
+        return undefined;
+      throw error;
+    },
+  );
+
+  if (fetched === undefined || fetched.rev === pending.baseRev) {
+    const continued = await carryOut(api, registered, pending, terminal, false);
+    return { ...continued, attempted: pending.document };
+  }
+
+  if (
+    fetched.rev === pending.baseRev + 1 &&
+    sameGraphDocument(fetched.document, pending.document)
+  ) {
+    return {
+      registered: await acknowledge(
+        api,
+        registered.id,
+        pending,
+        fetched.rev,
+        terminal,
+      ),
+      attempted: pending.document,
+      published: fetched,
+    };
+  }
+
+  throw canvasRevisionConflict(
+    api,
+    registered.id,
+    pending.baseRev,
+    fetched.rev,
+  );
+};
+
+/** Saves the complete request identity before its remote side effect begins. */
+export const preparePush = async (
+  api: string,
+  registered: Registered,
+  document: GraphDoc,
+  source: string,
+  terminal: Terminal,
+): Promise<Registered> => {
+  let prepared: Registered | undefined;
+  await updateRegistry((registry) => {
+    const current = registry.canvases[registered.id];
+    if (current === undefined) return;
+    const selected = { id: registered.id, entry: current };
+    requireSameApi(api, selected);
+    requireWriteToken(selected);
+    if (current.pendingPush !== undefined) return;
+
+    const entry: CanvasEntry = {
+      ...current,
+      pendingPush: { baseRev: current.rev, document, source },
+    };
+    registry.canvases[registered.id] = entry;
+    prepared = { id: registered.id, entry };
+  }, terminal);
+
+  if (prepared === undefined) throw registryChanged(registered.id);
+  return prepared;
+};
+
+export const carryOutPreparedPush = async (
+  api: string,
+  registered: Registered,
+  terminal: Terminal,
+): Promise<{ registered: Registered; published: PublishedCanvas }> => {
+  const pending = registered.entry.pendingPush;
+  if (pending === undefined) throw registryChanged(registered.id);
+  return carryOut(api, registered, pending, terminal, true);
+};
